# Salin menjadi .env lalu ganti semua nilai. File .env JANGAN di-commit / dibagikan.
DB_PASSWORD=ganti-password-database
# Minimal 32 karakter acak. Contoh membuat: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# 32 byte acak dalam base64. Contoh: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_KEY=ganti-dengan-32-byte-base64
# true = kode OTP ikut dikirim di respons API (simulasi, karena belum ada SMS/email sungguhan)
EXPOSE_OTP=true
# true = buat akun demo & riwayat contoh saat database masih kosong
SEED_DEMO_DATA=true
# Origin aplikasi Web yang boleh memanggil API langsung (pisahkan koma). Tambahkan domain Web saat deploy.
# Samakan juga dengan map $cors_origin di gateway/nginx.conf bila memakai gateway.
DDB_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
