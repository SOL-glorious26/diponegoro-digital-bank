<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lupa Sandi - diponegoro corp bank</title>
<link rel="icon" href="/assets/img/logo-mark.jpg">
<link rel="stylesheet" href="/assets/css/style.css">
<script src="/assets/js/pwtoggle.js" defer></script>
</head>
<body>
<div class="auth-wrap"><div class="auth-card">
  <div class="auth-logo"><img src="/assets/img/logo.jpg" alt="Diponegoro Corp"></div>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <% if (step === 'request') { %>
    <h1>Lupa Password / PIN</h1><p class="sub">Masukkan username, email, atau No. HP akunmu.</p>
    <form method="post" action="/lupa-sandi">
      <%- include('partials/csrf') %>
      <div class="field"><label>Username / Email / No. HP</label><input type="text" name="identitas" required></div>
      <div class="field"><label>Yang dipulihkan</label><select name="type"><option value="PASSWORD">Password</option><option value="PIN">PIN transaksi</option></select></div>
      <button class="btn" type="submit">Kirim Kode OTP</button>
    </form>
  <% } else { %>
    <h1>Atur <%= type === 'PIN' ? 'PIN' : 'Password' %> Baru</h1><p class="sub">Masukkan kode OTP dan <%= type === 'PIN' ? 'PIN (6 digit)' : 'password' %> baru.</p>
    <% if (demoOtp) { %><div class="alert info">Mode demo — kode OTP kamu: <b><%= demoOtp %></b></div><% } %>
    <form method="post" action="/lupa-sandi">
      <%- include('partials/csrf') %>
      <div class="field"><label>Kode OTP</label><input class="otp-box" type="text" name="kode" maxlength="6" required></div>
      <div class="field"><label><%= type === 'PIN' ? 'PIN Baru' : 'Kata Sandi Baru' %></label><input type="password" name="password" required <%- type === 'PIN' ? 'inputmode="numeric" maxlength="6"' : '' %>></div>
      <div class="field"><label>Ulangi</label><input type="password" name="password2" required <%- type === 'PIN' ? 'inputmode="numeric" maxlength="6"' : '' %>></div>
      <button class="btn" type="submit">Simpan</button>
      <p class="hint"><a href="/lupa-sandi?ulang=1" style="color:var(--primary)">Mulai ulang</a></p>
    </form>
  <% } %>
  <div class="link-row"><a href="/login">Kembali ke login</a></div>
</div></div>
</body>
</html>
