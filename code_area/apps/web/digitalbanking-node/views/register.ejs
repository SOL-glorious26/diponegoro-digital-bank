<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Daftar Akun - diponegoro corp bank</title>
<link rel="icon" href="/assets/img/logo-mark.jpg">
<link rel="stylesheet" href="/assets/css/style.css">
<script src="/assets/js/pwtoggle.js" defer></script>
</head>
<body>
<div class="auth-wrap"><div class="auth-card">
  <div class="auth-logo"><img src="/assets/img/logo.jpg" alt="Diponegoro Corp"></div>
  <h1>Daftar akun baru</h1>
  <p class="sub">Setelah daftar: verifikasi OTP, e-KYC, lalu buat PIN. Rekening tabungan dibuat otomatis.</p>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/register">
    <%- include('partials/csrf') %>
    <div class="field"><label>Username</label><input type="text" name="username" required autocomplete="username" value="<%= f.username || '' %>"></div>
    <div class="field"><label>Email</label><input type="email" name="email" value="<%= f.email || '' %>"></div>
    <div class="field"><label>No. HP</label><input type="text" name="no_hp" value="<%= f.no_hp || '' %>"></div>
    <div class="field"><label>Kata Sandi</label><input type="password" name="password" required></div>
    <div class="field"><label>Ulangi Kata Sandi</label><input type="password" name="password2" required></div>
    <button class="btn" type="submit">Daftar</button>
  </form>
  <div class="link-row"><a href="/login">Sudah punya akun? Masuk</a></div>
</div></div>
</body>
</html>
