<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Masuk - diponegoro corp bank</title>
<link rel="icon" href="/assets/img/logo-mark.jpg">
<link rel="stylesheet" href="/assets/css/style.css">
<script src="/assets/js/pwtoggle.js" defer></script>
</head>
<body>
<div class="auth-wrap"><div class="auth-card">
  <div class="auth-logo"><img src="/assets/img/logo.jpg" alt="Diponegoro Corp"></div>
  <h1>Masuk ke akun</h1>
  <p class="sub">Layanan perbankan digital — aman &amp; mudah.</p>
  <% if (flash) { %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <%- include('partials/csrf') %>
    <div class="field"><label>Email / No. HP</label><input type="text" name="identitas" required value="<%= identitas %>"></div>
    <div class="field"><label>Kata Sandi</label><input type="password" name="password" required></div>
    <button class="btn" type="submit">Login</button>
  </form>
  <div class="link-row"><a href="/register">Daftar akun</a><a href="/lupa-sandi">Lupa sandi?</a></div>
</div></div>
</body>
</html>
