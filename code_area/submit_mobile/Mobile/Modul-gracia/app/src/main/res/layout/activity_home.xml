<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvWelcome" android:textSize="24sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Pilih menu" android:layout_marginTop="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button android:id="@+id/btnQris" android:text="💳  Pembayaran QRIS"
            android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnProfile" android:text="👤  Lihat / Ubah Profil"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnSecurity" android:text="🔐  Kelola Keamanan"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnNotification" android:text="🔔  Notifikasi"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnLogout" android:text="Logout"
            android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
