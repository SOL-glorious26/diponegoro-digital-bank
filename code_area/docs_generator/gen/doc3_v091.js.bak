const path = require("path");
const fs = require("fs");
const S = require("./ddbstyle");
const { P, H1, H2, H3, B, NL, CAP, NOTE, table, img, PW } = S;
const [, , FIG2, FIG3, OUT, LOGO, OPENAPI] = process.argv;
const f2 = (n) => path.join(FIG2, n), f3 = (n) => path.join(FIG3, n);

// ---------- endpoints from openapi.json (source of truth)
const api = JSON.parse(fs.readFileSync(OPENAPI, "utf8"));
const fallback = {
  "PUT /api/v1/me/photo": "Ubah foto profil (URL) (FR-27)",
  "GET /api/v1/me/notification-settings": "Lihat pengaturan jenis & kanal notifikasi (FR-28)",
  "GET /api/v1/accounts/pockets/{id}": "Detail kantong (FR-08)",
  "POST /api/v1/transfers/favorites": "Tambah penerima favorit (FR-13)",
  "DELETE /api/v1/transfers/favorites/{id}": "Hapus penerima favorit (FR-13)",
  "POST /api/v1/me/notifications/{id}/read": "Tandai satu notifikasi sudah dibaca (FR-29)",
  "POST /api/v1/me/notifications/read-all": "Tandai semua notifikasi sudah dibaca (FR-29)",
  "GET /api/v1/cards": "Daftar virtual card (FR-21)",
  "POST /api/v1/cards/{id}/freeze": "Bekukan kartu (FR-22)",
  "POST /api/v1/cards/{id}/activate": "Aktifkan kembali kartu (FR-22)",
  "GET /api/v1/me/notifications/unread-count": "Jumlah notifikasi belum dibaca (FR-29)",
};
// openapi.json contains UTF-8 text that was decoded as Windows-1252 once (known issue in LANJUTKAN.md).
const MOJI = [["â†’", "→"], ["â€“", "–"], ["â€”", "—"], ["Â±", "±"], ["â€™", "’"], ["Ã—", "×"]];
const fixMojibake = (t) => { MOJI.forEach(([a, b]) => { t = t.split(a).join(b); }); if (/[ÂÃâ]/.test(t)) throw new Error("unfixed mojibake: " + t); return t; };
const tagOrder = ["1. Authentication", "2. Account", "3. Transfer", "4. Payment QRIS", "5. Top-up", "6. Virtual Card", "7. History & Dashboard", "8. Profile & Notification"];
const eps = [];
for (const [p, v] of Object.entries(api.paths)) for (const [m, o] of Object.entries(v)) {
  const key = `${m.toUpperCase()} ${p}`;
  eps.push({ tag: (o.tags || ["?"])[0], method: m.toUpperCase(), path: p.replace("/api/v1", ""), sum: fixMojibake((o.summary || fallback[key] || "").trim()) });
}
const missing = eps.filter((e) => !e.sum);
if (missing.length) throw new Error("summary missing: " + missing.map((e) => e.method + " " + e.path).join(", "));
const mOrder = { GET: 0, POST: 1, PUT: 2, DELETE: 3 };
const epRows = [];
tagOrder.forEach((t) => {
  const list = eps.filter((e) => e.tag === t).sort((a, b) => a.path.localeCompare(b.path) || mOrder[a.method] - mOrder[b.method]);
  epRows.push([{ t: `${t.replace(/^\d\. /, "")} (${list.length} operasi)`, bold: true, fill: S.KEY_FILL, span: 3 }]);
  list.forEach((e) => epRows.push([e.method, e.path, e.sum]));
});
if (eps.length !== 73) throw new Error("expected 73 operations, got " + eps.length);

