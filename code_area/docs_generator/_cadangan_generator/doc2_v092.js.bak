const path = require("path");
const S = require("./ddbstyle");
const { P, H1, H2, H3, B, NL, CAP, NOTE, table, img } = S;
const [, , FIG, OUT, LOGO] = process.argv;
const fig = (n) => path.join(FIG, n);

