};

const body = [
  // BAB I
  H1("BAB I  PENDAHULUAN"),
  H2("1.1 Tujuan Dokumen"),
  P("Dokumen ini menjelaskan arsitektur perangkat lunak platform PT Diponegoro Digital Bank: komponen utama, tanggung jawab dan hubungan antarkomponen, alur data, keputusan arsitektur beserta alasannya, serta pemenuhan kebutuhan non-fungsional. Dokumen ini menjadi acuan bagi Functional Design (Dokumen 3), Detailed Design (Dokumen 4), Developer Manual (Dokumen 7), dan pengujian sistem (Dokumen 6)."),
  H2("1.2 Ruang Lingkup"),
  P("Arsitektur yang dibahas mencakup aplikasi Android, aplikasi Web, API Gateway, backend, basis data, adapter/simulator layanan eksternal, dan lingkungan deployment. Arsitektur dideskripsikan **sesuai implementasi aktual per 11 November 2026**. Bagian yang masih berupa rencana atau menunggu keputusan diberi label eksplisit."),
  H2("1.3 Definisi dan Singkatan"),
  table(["Istilah", "Arti"], [
    ["Modular monolith", "Satu aplikasi backend yang dapat di-deploy sebagai satu unit, tetapi tersusun atas modul dengan batas tanggung jawab yang jelas."],
    ["API Gateway", "Titik masuk tunggal untuk seluruh permintaan klien: routing, rate limiting, CORS, dan terminasi TLS."],
    ["JWT", "JSON Web Token: token akses bertanda tangan yang dibawa klien pada header Authorization."],
    ["Ledger double-entry", "Pencatatan keuangan di mana setiap transaksi terdiri atas baris debit dan kredit yang jumlahnya nol."],
    ["Idempotency-Key", "Kunci unik per transaksi keuangan; permintaan berulang dengan kunci yang sama hanya menghasilkan satu efek."],
    ["Flyway", "Alat migrasi skema basis data berbasis berkas SQL berversi."],
    ["MVVM", "Model–View–ViewModel: pola arsitektur antarmuka yang memisahkan tampilan dari state dan logika presentasi."],
  ], [2500, 6570], { boldFirst: true }),
  CAP("Tabel 1.1 Definisi dan singkatan"),

  // BAB II
  H1("BAB II  KONTEKS DAN PENDORONG ARSITEKTUR"),
  H2("2.1 Konteks Sistem"),
  P("Sistem melayani tiga segmen nasabah (mahasiswa, profesional, UMKM) melalui aplikasi Android dan Web. Seluruh layanan eksternal, yaitu jaringan antarbank, jaringan QRIS, penyedia pulsa/PLN/tagihan, penerbit kartu, serta penyedia OTP dan e-KYC, digantikan oleh simulator sesuai batasan SRS 2.5. Administrator sistem disebut dalam SRS 2.3, tetapi berada di luar antarmuka pengguna ritel dan belum diimplementasikan."),
  img(fig("d2_context.png"), 560, { alt: "Diagram konteks" }),
  CAP("Gambar 2.1 Diagram konteks sistem"),
  H2("2.2 Pendorong Arsitektur"),
  P("Keputusan arsitektur didorong oleh kebutuhan dan batasan berikut:"),
  table(["Pendorong", "Sumber", "Konsekuensi arsitektur"], [
    ["Satu logika bisnis untuk Android dan Web", "SRS 2.1; Project Brief §9", "Satu backend bersama di belakang API Gateway; kontrak OpenAPI dipakai bersama"],
    ["Integritas transaksi keuangan", "BR-03, BR-04, BR-05, NFR-07", "Financial Transaction Core terpusat: ledger double-entry, transaksi DB atomik, kunci baris, idempotensi, refund"],
    ["Keamanan", "NFR-06, FR-04, FR-05", "JWT berumur pendek + sesi di basis data, BCrypt, enkripsi data kartu, rate limiting di gateway"],
    ["Kecepatan dan keandalan", "NFR-01 – NFR-05", "Notifikasi asinkron, paginasi riwayat, backend stateless pada tingkat instance"],
    ["Skalabilitas dan pemeliharaan", "NFR-09, NFR-12", "Batas modul jelas agar dapat dipecah menjadi layanan; OpenAPI otomatis; migrasi Flyway; test otomatis"],
    ["Lingkup akademik dan data simulasi", "SRS 2.5", "Adapter/simulator untuk layanan eksternal; data demo otomatis"],
    ["Tim kecil, satu pengembang backend", "Keputusan Project Owner", "Modular monolith, bukan microservices"],
  ], [2600, 2000, 4470], { boldFirst: true, size: 18 }),
  CAP("Tabel 2.1 Pendorong arsitektur"),

  // BAB III
  H1("BAB III  GAMBARAN UMUM ARSITEKTUR"),
  H2("3.1 Gaya Arsitektur"),
  P("Sistem memakai arsitektur **client–server berlapis** dengan empat lapisan: klien (Android dan Web), gerbang (API Gateway), layanan inti (backend modular monolith), dan data (PostgreSQL serta simulator eksternal). Klien tidak pernah mengakses basis data atau simulator secara langsung. Seluruh akses melewati API REST berformat JSON di bawah prefiks /api/v1."),
  img(fig("d2_highlevel.png"), 560, { alt: "Arsitektur tingkat tinggi" }),
  CAP("Gambar 3.1 Arsitektur tingkat tinggi"),
  H2("3.2 Tanggung Jawab Komponen Utama"),
  table(["Komponen", "Tanggung jawab", "Teknologi", "Status"], [
    ["Aplikasi Android", "Antarmuka nasabah di ponsel, termasuk pindai QRIS dan biometrik", "Kotlin, Jetpack Compose, MVVM, Retrofit", "8 modul; varian demo (in-memory) dan online (REST)"],
    ["Aplikasi Web", "Antarmuka nasabah di peramban, termasuk ekspor riwayat (FR-26)", "React + JavaScript, Vite, react-router-dom, axios", "Prototipe UI; integrasi API dalam pengerjaan"],
    ["API Gateway", "Satu pintu /api/**, rate limiting, CORS, header keamanan, TLS", "Nginx 1.27", "Konfigurasi siap; belum diuji"],
    ["Backend", "Seluruh logika bisnis 8 modul, keamanan, ledger, notifikasi", "Java 21, Spring Boot 4.1.2", "Implementasi selesai; 45 test lulus"],
    ["Basis data", "Penyimpanan permanen dan konsistensi kuat transaksi", "PostgreSQL 17/18, Flyway", "Skema V1 (17 tabel)"],
    ["Simulator eksternal", "Pengganti layanan antarbank, QRIS, biller, penerbit kartu, OTP, e-KYC", "Komponen Java di backend", "Tersedia"],
  ], [1700, 3270, 2200, 1900], { boldFirst: true, size: 18 }),
  CAP("Tabel 3.1 Komponen utama"),

  // BAB IV Backend
  H1("BAB IV  ARSITEKTUR BACKEND"),
  H2("4.1 Struktur Modul"),
  P("Backend adalah satu proyek Spring Boot (artefak ddb-backend) dengan paket dasar com.diponegoro.ddb. Setiap modul bisnis SRS menjadi satu paket. Di dalam paket, lapisan mengikuti pola **Controller → Service → Repository/Entity**: controller menerima permintaan HTTP dan validasi input, service memuat aturan bisnis dan batas transaksi, sedangkan repository/entitas JPA mengakses basis data."),
  img(fig("d2_modules.png"), 560, { alt: "Struktur modul backend" }),
  CAP("Gambar 4.1 Struktur modul backend dan komponen lintas modul"),
  table(["Paket", "Modul / FR", "Kelas utama"], [
    ["auth", "Authentication, FR-01 – FR-05", "AuthController, AuthService, OtpService, PinService, TransactionGuard, LoginThrottle"],
    ["account", "Account, FR-06 – FR-09", "AccountController, AccountService, Pocket"],
    ["transfer", "Transfer, FR-10 – FR-14", "TransferController, TransferService, InterbankGateway, InterbankSimulator, FavoriteRecipient"],
    ["payment", "Payment (QRIS), FR-15 – FR-17", "PaymentController, PaymentService, QrisCodec (EMVCo + CRC16)"],
    ["topup", "Top-up, FR-18 – FR-20", "TopUpController, TopUpService, TopUpCatalog, PaidBill"],
    ["card", "Virtual Card, FR-21 – FR-22", "VirtualCardController, VirtualCardService, VirtualCard"],
    ["history", "Transaction History & Dashboard, FR-23 – FR-26", "HistoryController, HistoryService, HistoryExporter (CSV/PDF)"],
    ["profile, notification", "Profile & Notification, FR-27 – FR-29", "ProfileController, ProfileService, NotificationService, NotificationSettings"],
    ["ledger", "Financial Transaction Core", "LedgerService, LedgerAccount, LedgerTransaction, JournalLine"],
    ["security", "Autentikasi token", "SecurityConfig, JwtService, SessionJwtConverter, AuthUser"],
    ["common", "Lintas modul", "GlobalExceptionHandler, ErrorResponse, Idempotency, Money, DataCipher, AuditService, OpenApiConfig"],
    ["demo", "Data demo", "DemoDataSeeder"],
  ], [1800, 2900, 4370], { boldFirst: true, size: 18 }),
  CAP("Tabel 4.1 Paket backend dan kelas utama"),
  H2("4.2 Financial Transaction Core"),
  P("Seluruh perpindahan dana dari modul account, transfer, payment, topup, dan card melewati **LedgerService**. Mekanisme yang diterapkan:"),
  B("**Double-entry:** setiap transaksi menulis baris jurnal (journal_lines) yang jumlah debit dan kreditnya nol (BR-03)."),
  B("**Atomik dengan kunci baris:** posting berjalan dalam satu transaksi basis data, dan rekening yang terlibat dikunci dengan SELECT … FOR UPDATE. Mekanisme ini menutup bug lost update saldo yang ditemukan melalui uji transfer paralel."),
  B("**Idempotensi:** setiap transaksi keuangan membawa header Idempotency-Key. Permintaan berulang dengan kunci yang sama mengembalikan hasil yang sama tanpa debit ganda (BR-04)."),
  B("**Refund:** transfer antarbank yang ditolak dibalik dengan jurnal pembalik, bukan dengan menghapus data (BR-05)."),
  B("**Event:** setelah transaksi tercatat, ledger menerbitkan event yang diproses modul notifikasi secara asinkron (@Async), sehingga notifikasi tidak memperlambat respons transaksi (FR-29, NFR-03)."),
  B("**Gerbang transaksi:** sebelum posting, modul transaksi memanggil TransactionGuard untuk memastikan e-KYC disetujui dan PIN valid, dengan blokir 5 menit setelah 3 kali salah (FR-02, FR-04, BR-02)."),
  H2("4.3 Alur Runtime: Transfer Dana (UC-01)"),
  P("Gambar 4.2 menunjukkan interaksi komponen pada transfer antarbank, termasuk alur alternatif A5 (timeout → status Diproses) dan A6 (ditolak → refund)."),
  img(fig("d2_sequence.png"), 600, { alt: "Sequence transfer" }),
  CAP("Gambar 4.2 Interaksi komponen pada transfer dana"),
  H2("4.4 Keamanan Backend"),
  table(["Aspek", "Penerapan", "Kebutuhan"], [
    ["Token akses", "JWT HS256 berumur 15 menit; refresh token 7 hari yang dirotasi", "NFR-06"],
    ["Sesi", "Setiap token divalidasi terhadap catatan sesi di basis data, sehingga logout semua perangkat langsung berlaku; sesi berakhir setelah 5 menit tidak aktif", "FR-05"],
    ["Kredensial", "BCrypt untuk password, PIN, dan OTP; PIN terpisah dari password", "FR-04, NFR-06"],
    ["Pembatasan percobaan", "Login dikunci 15 menit setelah 5 kali password salah; PIN diblokir 5 menit setelah 3 kali salah", "BR-02, NFR-06"],
    ["Data kartu", "Nomor kartu dan CVV dienkripsi AES-GCM (DataCipher); detail hanya tampil setelah PIN valid", "FR-22, NFR-11"],
    ["Rahasia", "JWT_SECRET, DATA_KEY, DB_PASSWORD dibaca dari environment variable", "NFR-06"],
    ["Jejak audit", "Kejadian penting dicatat di tabel audit_events", "NFR-07"],
    ["Pesan kesalahan", "Format seragam {code, message, fields}; detail internal tidak dibuka", "FR-03, NFR-08"],
  ], [1900, 5570, 1600], { boldFirst: true, size: 18 }),
  CAP("Tabel 4.2 Mekanisme keamanan backend"),

  // BAB V Data
  H1("BAB V  ARSITEKTUR DATA"),
  H2("5.1 Basis Data dan Migrasi"),
  P("Data disimpan di **PostgreSQL** (17 di kontainer, 18 di lingkungan lokal). Skema hanya diubah melalui migrasi **Flyway** (berkas V1__init.sql), dan Hibernate berjalan dalam mode validate sehingga aplikasi tidak pernah mengubah skema secara implisit. Waktu disimpan dalam UTC. Tiga profil konfigurasi tersedia: dev (PostgreSQL lokal), test (H2 in-memory dalam mode PostgreSQL, untuk test otomatis), dan h2 (berkas H2 lokal, untuk percobaan cepat)."),
  H2("5.2 Kelompok Data"),
