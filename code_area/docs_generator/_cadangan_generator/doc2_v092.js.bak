    ["Rate limit API umum", "20 permintaan/detik per IP (burst 40)"],
    ["Rate limit login, registrasi, biometrik, pemulihan", "10 permintaan/menit per IP (burst 5)"],
    ["CORS", "Origin localhost/127.0.0.1 diizinkan; header Authorization, Content-Type, Idempotency-Key"],
    ["Header keamanan", "X-Content-Type-Options: nosniff; server_tokens off; ukuran body maksimum 2 MB"],
    ["Dokumentasi dan kesehatan", "/swagger-ui, /v3/api-docs, /health (actuator)"],
  ], [3700, 5370], { boldFirst: true, size: 18 }),
