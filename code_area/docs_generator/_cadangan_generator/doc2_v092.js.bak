    ["ADR-02", "Satu backend bersama di belakang API Gateway", "SRS 2.1; perilaku Android dan Web konsisten (NFR-08)", "Klien bergantung pada ketersediaan backend; mitigasi flavor demo di Android"],
    ["ADR-03", "PostgreSQL + Flyway; H2 untuk test", "Konsistensi kuat transaksi (SRS 2.5); test cepat tanpa server DB", "Perbedaan dialek H2/PostgreSQL perlu diuji ulang di PostgreSQL"],
    ["ADR-04", "Ledger double-entry, kunci baris, Idempotency-Key", "BR-03, BR-04, BR-05, NFR-07", "Konsistensi terjamin; kunci baris dapat membatasi konkurensi pada rekening yang sama"],
    ["ADR-05", "JWT berumur pendek + validasi sesi di basis data", "Logout semua perangkat harus langsung berlaku (FR-05)", "Satu query sesi per permintaan; instance tetap stateless karena sesi di basis data"],
    ["ADR-06", "Layanan eksternal sebagai simulator", "SRS 2.5; tidak ada akses ke jaringan produksi", "Antarbank sudah berupa adapter; QRIS, biller, dan kartu perlu dipisah menjadi adapter"],
    ["ADR-07", "Rate limiting dan CORS di Nginx", "NFR-06; perlindungan login/OTP dari brute force", "Logika keamanan jaringan terpusat di gateway"],
    ["ADR-08", "Notifikasi asinkron berbasis event", "FR-29; transfer ≤ 3 detik (NFR-03)", "Notifikasi dapat tertunda sesaat setelah transaksi"],
    ["ADR-09", "Android MVVM + Repository; flavor demo dan online", "Aplikasi dapat diuji tanpa backend; migrasi ke REST tanpa mengubah UI", "Dua implementasi repository perlu dijaga konsistensinya"],
    ["ADR-10", "Docker Compose; rahasia via environment", "Lingkungan seragam lokal dan cloud; NFR-12", "Memerlukan Docker di mesin penguji/demo"],
    ["ADR-11", "Web sebagai SPA React + Vite dengan route guard login dan e-KYC", "Melanjutkan prototipe; FR-02, FR-03", "Logika bisnis tetap di backend; Web hanya klien tipis"],
    ["ADR-12", "Token Web: access di memori, refresh di sessionStorage; Idempotency-Key dari klien", "Sesi tidak bertahan setelah tab ditutup; BR-04", "Rentan bila terjadi XSS; produksi disarankan cookie httpOnly"],
